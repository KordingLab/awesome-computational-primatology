# Python
__pycache__/
*.py[cod]
*$py.class
.env
.env.local
.venv/
venv/

# GCP credentials (NEVER commit these)
service-account*.json
credentials*.json
*-key.json

# JSON files (default ignore, with exceptions)
*.json
!package.json
!package-lock.json
# Backend data is synced from data/ during deployment
!backend/data/*.json
# Paper Scout state is committed by the bot
!docs/scout-state.json

# Large binary/generated data (regenerate with scripts/rag/).
# Track only the small source corpus used by the backend + scout.
data/*
!data/papers_with_abstracts.json

docs/PAPERS_TO_DOWNLOAD.md

# IDEs
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Personal notes (not tracked)
NOTES.md
TODO.md
CLAUDE.md

# Old/intermediate README versions
README_old.md
README_updated.md

# Claude Desktop
.claude/

# Local trash (deleted files kept locally)
trash/

# Local development scripts with hardcoded paths
scripts/run_local.sh